# ==============================================================================
# Stock Researcher Agent - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your actual secrets.
# NEVER commit the real .env file or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google AI Studio / Gemini API
# Get your API key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# ------------------------------------------------------------------------------
# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# Requesty API Configuration
# Found in: Requesty Dashboard / Router (https://requesty.ai)
# ------------------------------------------------------------------------------
REQUESTY_API_KEY=your_requesty_api_key_here
REQUESTY_BASE_URL=https://router.requesty.ai/v1
REQUESTY_MODEL=google/gemma-4-31b-it

# ------------------------------------------------------------------------------
# Server / Runtime Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
